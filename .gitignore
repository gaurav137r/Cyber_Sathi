# Dependencies
node_modules/

# Builds
dist/
build/
.cache/
*.tsbuildinfo

# Env (keep examples)
.env
.env.*
!.env.example

# Vite / frontend
.vite/
vite.config.*.timestamp-*

# Logs
logs/
*.log
*-debug.log*

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Local object storage / compose volumes (if bound)
.tmp-*
.docker-data/

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
.claude-replay.*

# AI agent / coding-assistant metadata and local workspace state
.ai/
.agent/
.agents/
.claude/
.cursor/
.windsurf/
.gemini/
.copilot/
.copilot-*/
.opencode/
.opencode-*/
.mcp.json
*.instructions.md
*.prompt.md
*.agent.md

# Keep this file local; do not commit or push it
.gitignore
