{
  "name": "cyber-sathi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "api:build": "corepack pnpm --filter @cybersathi/api build",
    "api:start:dev": "corepack pnpm --filter @cybersathi/api start:dev",
    "api:prisma:generate": "corepack pnpm --filter @cybersathi/api prisma:generate",
    "api:prisma:migrate": "corepack pnpm --filter @cybersathi/api prisma:migrate",
    "mobile:start": "pnpm --filter @cybersathi/mobile start",
    "start:dev": "pnpm api:start:dev"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
