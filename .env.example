# API
NODE_ENV=development
PORT=3000

# Postgres 16 (Compose service: postgres)
DATABASE_URL=postgresql://cybersathi:cybersathi@localhost:5432/cybersathi?schema=public

# Redis 7 (Compose service: redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible; Compose service: minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cybersathi-evidence
MINIO_USE_SSL=false

# Stage 4 will replace this with real auth. Required so case APIs can run now.
STUB_USER_ID=00000000-0000-4000-8000-000000000001
