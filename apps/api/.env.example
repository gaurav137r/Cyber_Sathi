# API
NODE_ENV=development
PORT=3000

# Postgres 16 (Compose service: postgres)
# DATABASE_URL=
# Redis settings are only needed if BullMQ workers are enabled.
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO settings are only needed if the legacy MinIO module is enabled.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cybersathi-evidence
MINIO_USE_SSL=false

# Stage 4 will replace this with real auth. Required so case APIs can run now.
STUB_USER_ID=00000000-0000-4000-8000-000000000001
# Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_EVIDENCE_BUCKET=evidence
SUPABASE_SOCIAL_POSTS_BUCKET=social-posts
SUPABASE_JWKS_URL=
DATABASE_URL=

# Client-facing Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bland AI (server-side only — never expose to client)
BLAND_API_KEY=

# Bland AI Agent ID (for SDK voice integration)
BLAND_AGENT_ID=
# Soothing, smooth, calm, consoling Hindi-accent voice (default: AAVY c8bfeab1-1844-4d0f-9c46-acb011d7e99c)
BLAND_VOICE=c8bfeab1-1844-4d0f-9c46-acb011d7e99c
BLAND_WEBHOOK_SECRET=
BLAND_WEBHOOK_URL=

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
NCRP_PORTAL_URL=https://cybercrime.gov.in/



GEMINI_API_KEY=
# Live voice is handled by the Bland web agent. Enable Gemini Live only if you
# deliberately use the alternate GeminiLiveVoice flow.
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TEXT_FALLBACK=gemini-3.1-flash-lite
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_FALLBACK=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1

# Multiple keys (comma-separated, takes priority over single):
GEMINI_API_KEYS=
GROQ_API_KEYS=
LLM_API_KEYS=

BLAND_API_KEY=
# Bland AI Agent ID (for SDK voice integration)
BLAND_AGENT_ID=

# Profile encryption (server-side only — never expose to client)
PROFILE_ENCRYPTION_KEY=profile-encryption-dev-key-change-me-in-production


# === TEXT (report generation, summaries, classification) ===
REPORT_MODEL_PROVIDER=groq
REPORT_MODEL_NAME=openai/gpt-oss-120b
REPORT_MODEL_FALLBACK=gemini-3.6-flash

# === BILINGUAL (Hindi/English summaries) ===
BILINGUAL_MODEL=qwen/qwen3.8-27b
BILINGUAL_FALLBACK=gemini-3.6-flash

# === IMAGE (social post generation) ===
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK=gemini-3-pro-image
GEMINI_IMAGE_ENABLED=false

# === AUDIO (call recording transcription) ===
GROQ_WHISPER_MODEL=whisper-large-v3

# === FAST/CHEAP (classification, entity extraction) ===
FAST_MODEL=openai/gpt-oss-20b
FAST_FALLBACK=gemini-3.1-flash-lite

# === COMPLEX (full report compilation) ===
COMPLEX_MODEL=gemini-3.6-flash
COMPLEX_FALLBACK=openai/gpt-oss-120b   

# Image generation (primary): Cloudflare Workers AI / Flux Schnell
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_token
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_STEPS=4
IMAGE_TIMEOUT_MS=60000
IMAGE_MAX_BYTES=8388608
IMAGE_MIN_DIMENSION=256
IMAGE_MAX_DIMENSION=2048

# Poster composition (ImageMagick 7 + SVG typography).
# Fonts must be installed locally; these paths are for Fedora.
IMAGE_FONT_REGULAR=/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf
IMAGE_FONT_BOLD=/usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf
IMAGE_FONT_DEVANAGARI=/usr/share/fonts/google-noto-vf/NotoSansDevanagari[wght].ttf
IMAGE_FONT_FAMILY=DejaVu Sans
IMAGE_FONT_FAMILY_BOLD=DejaVu Sans
IMAGE_FONT_FAMILY_DEVANAGARI=Noto Sans Devanagari
# Local project storage for generated artwork (gitignored).
IMAGE_STORAGE_DIR=.data/generated-images
# Private Supabase Storage bucket; created automatically on first upload.
SUPABASE_IMAGES_BUCKET=case-images

# Fallback (if Cloudflare quota hit):
IMAGE_FALLBACK_PROVIDER=pollinations
# No key needed for classic endpoint:
IMAGE_FALLBACK_URL=https://image.pollinations.ai/prompt/   
