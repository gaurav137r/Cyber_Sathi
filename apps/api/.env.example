NODE_ENV=development
PORT=3000
# Replace with the Supabase Postgres connection URI from Project Settings > Database.
DATABASE_URL=postgresql://cybersathi:cybersathi_dev_password@localhost:5432/cybersathi?schema=public
# Supabase project URL from Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (safe for clients when Row Level Security is configured).
SUPABASE_PUBLISHABLE_KEY=your-sb_publishable-key
# Legacy anon key is also accepted by the API; prefer the publishable key above.
# SUPABASE_ANON_KEY=your-legacy-anon-key
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=cybersathi_minio
MINIO_SECRET_KEY=cybersathi_minio_dev_password
MINIO_BUCKET=cybersathi-evidence-dev
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE_NAME=Kore
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
NCRP_PORTAL_URL=https://cybercrime.gov.in/
RBI_OMBUDSMAN_PORTAL_URL=https://cms.rbi.org.in/
